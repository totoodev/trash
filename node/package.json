{
  "name": "trash-pro",
  "version": "0.1.0",
  "description": "Move files and folders to the OS trash/recycle bin (macOS, Windows, Linux), with a temp-directory fallback for headless systems. Batch-capable, built on trash-rs + napi-rs.",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "keywords": [
    "trash",
    "recycle-bin",
    "wastebasket",
    "delete",
    "remove",
    "napi-rs",
    "node-rs"
  ],
  "engines": {
    "node": ">= 10"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "trash-pro",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "create-npm-dirs": "napi create-npm-dirs",
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "optionalDependencies": {
    "trash-pro-darwin-arm64": "0.1.0",
    "trash-pro-darwin-x64": "0.1.0",
    "trash-pro-linux-arm64-gnu": "0.1.0",
    "trash-pro-linux-arm64-musl": "0.1.0",
    "trash-pro-linux-x64-gnu": "0.1.0",
    "trash-pro-linux-x64-musl": "0.1.0",
    "trash-pro-win32-arm64-msvc": "0.1.0",
    "trash-pro-win32-x64-msvc": "0.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
